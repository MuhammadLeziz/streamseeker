{
  "name": "world-watcher",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start:web": "npm run start -w @world-watcher/web",
    "start:api": "npm run start:dev -w @world-watcher/api",
    "build": "npm run build -w @world-watcher/shared && npm run build -w @world-watcher/web && npm run build -w @world-watcher/api",
    "build:shared": "npm run build -w @world-watcher/shared",
    "build:web": "npm run build -w @world-watcher/web",
    "build:api": "npm run build -w @world-watcher/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
