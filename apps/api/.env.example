# Copy to .env and adjust. docker-compose.yml at the repository root brings up a
# PostgreSQL matching these defaults: `docker compose up -d db`.
DATABASE_URL="postgresql://manara:manara@localhost:5432/manara?schema=public"

# Port the API listens on. The Angular development environment points at 3000.
PORT=3000

# Origins allowed to call the API, comma separated.
WEB_ORIGIN="http://localhost:4200"
